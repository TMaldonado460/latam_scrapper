# TMDB token: use a v4 Read Access Token (eyJ...) OR a v3 api key.
# Without it, titles come from Cinemeta (English) and Cuevana/HomeCine
# matching still works but Spanish-title sources degrade.
TMDB_TOKEN=

# Optional Upstash Redis cache (free tier). Greatly speeds up repeat views.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional MediaFlow proxy URL (https://your-mediaflow/proxy). Unlocks
# referer-protected hosts on Android. Only needed for hosts that block.
MEDIAFLOW_URL=
